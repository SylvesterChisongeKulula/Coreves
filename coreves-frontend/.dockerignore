.env
.env.*
!.env.example

# Version control
.git
.gitignore

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml

# Editor/OS
.DS_Store
.fleet
.idea
.vscode

# Logs
logs
*.log
