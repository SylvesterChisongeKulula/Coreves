# Resend (https://resend.com) — used to send demo-request confirmation
# and notification emails from server/api/demo-request.post.ts
RESEND_API_KEY=

# Business inbox that receives new demo request notifications
DEMO_NOTIFICATION_EMAIL=

# Verified sender address/display name used as the "From" for both emails.
# Must be on a domain verified in Resend.
DEMO_FROM_EMAIL="Coreves <noreply@yourdomain.com>"

# Google Analytics 4 measurement ID. Leave empty until a GA4 property exists.
NUXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console meta verification token. DNS verification can be used instead.
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Canonical production URL, no trailing slash. Drives canonical links, Open Graph
# URLs and JSON-LD @id values in app/pages/index.vue. Defaults to
# https://coreves.software in nuxt.config.ts if left unset.
NUXT_PUBLIC_SITE_URL=https://coreves.software
