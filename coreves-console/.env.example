# Local development (npm run dev). Production values live in Dokploy.
NUXT_DATABASE_URL=postgres://console:console@localhost:5434/console
# 32+ random characters: openssl rand -hex 32
NUXT_SESSION_PASSWORD=
# Ed25519 private key PEM — the SAME key whose public half is baked into CoreVesFin
# images (~/.corevesfin/licence/licence-private.pem). Single line with \n is fine.
NUXT_LICENCE_PRIVATE_KEY=
# Shared with the website's LEADS_WEBHOOK_SECRET.
NUXT_LEADS_WEBHOOK_SECRET=
# Empty in dev → emails (incl. sign-in codes) are printed to the server log.
NUXT_RESEND_API_KEY=
NUXT_OWNER_EMAIL=
NUXT_OWNER_PASSWORD=
NUXT_PUBLIC_CONSOLE_URL=http://localhost:3000
